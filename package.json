{
  "name": "talkincode-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare-based private asset service: hash-addressed uploads, expiring links, admin dashboard behind Cloudflare Access.",
  "type": "module",
  "bin": {
    "assets": "./cli/assets.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "db:init": "wrangler d1 execute talkincode-assets --remote -y --file=./schema.sql",
    "db:init:local": "wrangler d1 execute talkincode-assets --local -y --file=./schema.sql",
    "key:bootstrap": "node scripts/bootstrap-key.mjs",
    "access:setup": "bash scripts/setup-access.sh",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
